@article{shao_brucevincent_2023,
	title = {Bruce–{Vincent} transference numbers from molecular dynamics simulations},
	volume = {158},
	issn = {0021-9606},
	doi = {10.1063/5.0146608},
	abstract = {Transference number is a key design parameter for electrolyte materials used in electrochemical energy storage systems. However, the determination of the true transference number from experiments is rather demanding. On the other hand, the Bruce–Vincent method is widely used in the lab to approximately measure transference numbers of polymer electrolytes, which becomes exact in the limit of infinite dilution. Therefore, theoretical formulations to treat the Bruce–Vincent transference number and the true transference number on an equal footing are clearly needed. Here, we show how the Bruce–Vincent transference number for concentrated electrolyte solutions can be derived in terms of the Onsager coefficients, without involving any extrathermodynamic assumptions. By demonstrating it for the case of poly(ethylene oxide)–lithium bis(trifluoromethane)sulfonimide system, this work opens the door to calibrating molecular dynamics (MD) simulations via reproducing the Bruce–Vincent transference number and using MD simulations as a predictive tool for determining the true transference number.},
	number = {16},
