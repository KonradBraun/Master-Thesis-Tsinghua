	pages = {139--146},
	file = {PDF:C\:\\Users\\konra\\Zotero\\storage\\WEXTKXI6\\Lee et al. - 2018 - A facile method to enhance the uniformity and adhesion properties of water-based ceramic coating lay.pdf:application/pdf},
}

@article{ma_modified_2025,
	title = {A {Modified} {Sand}’s {Time} {Incorporating} {Li}-{Ion} {Transport} {Across} the {SEI}: {Basis} for {Understanding} {Li} {Dendrite} {Formation} and {Li}-{Metal} {Battery} {Electrolyte} {Selection}},
	volume = {172},
	issn = {0013-4651, 1945-7111},
	shorttitle = {A {Modified} {Sand}’s {Time} {Incorporating} {Li}-{Ion} {Transport} {Across} the {SEI}},
	doi = {10.1149/1945-7111/adba94},
	abstract = {Understanding the initiation of lithium dendrites remains elusive, largely due to the intricate role of the solid electrolyte interphase (SEI) which forms on the Li surface during electrodeposition. Many studies have utilized the classical Sand’s equation to estimate the onset time when lithium dendrites begin to form. The Sand’s equation provides the time when the cation (Li
              +
              ) concentration at the electrode-electrolyte interface approaches zero under diffusion-limited conditions in galvanostatic Li electrodeposition. However, recent experimental studies have revealed that the observed lithium dendrite onset time deviates considerably from the Sand’s time. Here, we show that this deviation from classical theory is likely due to the transport of Li
              +
              ions through the SEI - a transport limitation that is much more dominant in controlling dendrite formation. We develop a “modified” Sand’s equation, incorporating the SEI layer and the diffusional transport across it to predict Li dendrite onset times. To validate this approach, we conducted Li electrodeposition experiments at various current densities using two distinct organic electrolytes. Analysis of the results demonstrates that the modified Sand’s equation provides a more accurate prediction of dendrite onset times, highlighting the importance of incorporating SEI into transport models of Li plating in next-generation rechargeable Li-metal batteries.},
	language = {en},
	number = {3},
	journal = {Journal of The Electrochemical Society},
	author = {Ma, Yuanman and Selvasundarasekar, Sam Sankar and Sinclair, Nicholas and Zhang, Yubin and Xu, Shaomao and Bracey, Jennifer and Akolkar, Rohan},
	month = mar,
	year = {2025},
	pages = {030506},
	file = {PDF:C\:\\Users\\konra\\Zotero\\storage\\RX98F8IR\\Ma et al. - 2025 - A Modified Sand’s Time Incorporating Li-Ion Transport Across the SEI Basis for Understanding Li Den.pdf:application/pdf},
}

