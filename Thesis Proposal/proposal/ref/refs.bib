	pages = {366--369},
	annote = {Lit review §2.4What: perspective on approximate (BV) vs rigorous transference numbers and reference-frame dependence.
Numbers: n/r (abstract).
Relevance: high — values from different methods/frames are not comparable. INT (LBNL/Berkeley). Abstract only.},
}


